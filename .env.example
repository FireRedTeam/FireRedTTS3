# 复制本文件为 `.env` 并填入你的实际值。
# cp .env.example .env

# llm_tn（LLM 文本归一化）所用 LLM 网关的基础配置。
LLM_TN_API_URL=https://your-api-base/chat/completions
LLM_TN_API_KEY=your-api-key-here
# 推荐使用 qwen3-30b-a3b 及以上模型（deepseek-v4-flash）
# 自动根据模型名选择关闭 CoT 的方式：
#   - 模型名含 "deepseek" 时 → "thinking": {"type": "disabled"}
#   - 模型名含 "qwen"    时 → "chat_template_kwargs": {"enable_thinking": False}
LLM_TN_MODEL=deepseek-v4-flash